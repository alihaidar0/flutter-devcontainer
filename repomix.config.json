{
  "output": {
    "filePath": "flutter-devcontainer-code.xml",
    "style": "xml",
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "parsableStyle": true,
    "topFilesLength": 10,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100
    },
    "headerText": "flutter-devcontainer — Base Docker development environment image for Flutter projects.\nGenerated by Repomix for AI-assisted code review and analysis."
  },
  "include": [
    ".github/**",
    "docker/**",
    "scripts/**",
    "README.md",
    ".dockerignore",
    ".gitignore"
  ],
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      "flutter-devcontainer-code.xml",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.svg",
      "*.ico"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}