{
  "output": {
    "filePath": "flutter-devcontainer-code.xml",
    "style": "xml",
    "compress": true,
    "removeComments": true,
    "removeEmptyLines": true,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "parsableStyle": true,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100
    },
    "headerText": "flutter-devcontainer – Base Docker development environment image for Flutter projects."
  },
  "include": [
    "**/*",
    ".github/**/*"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "flutter-devcontainer-code.xml",
      "repomix.config.json",
      "*.md",
      "*.yaml",
      "*.yml",
      "*.json",
      "*.txt",
      "*.log",
      "*.lock",
      "*.png",
      "*.jpg",
      "*.svg",
      "*.ico",
      "build/**",
      ".dart_tool/**",
      ".flutter-plugins*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}