# =============================================================
#  Flutter Dev Container
#
#  Base: node:24-bookworm-slim (Node.js 24 Active LTS on Debian 12)
#  Node is a first-class runtime dependency: Firebase CLI and
#  FlutterFire CLI both require it. The official node image ensures
#  Dependabot tracks the base image version automatically.
#
#  Pre-installed (environment only — no application code):
#    Flutter SDK      — stable channel, always latest
#    Dart SDK         — bundled with Flutter
#    Android SDK      — platform-tools, android-36, build-tools 36.0.0
#    Gradle 9.7.1     — pre-cached at /opt/gradle
#    Java 21          — Eclipse Temurin (Adoptium); OpenJDK 21 is not
#                       available in Debian 12 APT repositories
#    Node.js 24 LTS   — required by Firebase CLI
#    pnpm             — activated via Corepack at build time
#    Firebase CLI     — pinned, manually tracked
#    FlutterFire CLI  — installed via dart pub global
#    Google Chrome    — amd64; Chromium on arm64
#    Linux desktop    — clang, cmake, ninja, GTK3
#    Git + GitHub CLI — git-lfs excluded (project-level concern)
#    openssh-client
#    Starship prompt + Flutter/Dart/Git shell aliases
# =============================================================

ARG NODE_VERSION=24

FROM node:${NODE_VERSION}-bookworm-slim

# Re-declare after FROM so the ARG is available in this build stage.
ARG NODE_VERSION

LABEL org.opencontainers.image.title="Flutter Dev Container"
LABEL org.opencontainers.image.description="Full-stack Flutter development environment — Android · Web · Linux Desktop · Node 24 LTS · Firebase · FlutterFire"
LABEL org.opencontainers.image.authors="Ali Haidar"
LABEL org.opencontainers.image.source="https://github.com/alihaidar0/flutter-devcontainer"

# ── Pinned versions ───────────────────────────────────────────
# Last verified: 2026-08-20.
#   Gradle, firebase-tools, and pnpm confirmed against their official
#   release channels on this date. cmdline-tools build number and the
#   Android platform/build-tools levels were NOT re-verified this pass —
#   check https://developer.android.com/studio#command-tools and
#   https://developer.android.com/tools/releases/platforms before bumping,
#   since a wrong cmdline-tools build number breaks the image build outright.
ENV GRADLE_VERSION=9.7.1 \
    FIREBASE_TOOLS_VERSION=15.27.0 \
    PNPM_VERSION=11.22.0 \
    ANDROID_SDK_ROOT=/home/developer/Android/sdk \
    FLUTTER_ROOT=/home/developer/flutter \
    GRADLE_HOME=/opt/gradle \
    GRADLE_USER_HOME=/home/developer/.gradle \
    PUB_CACHE=/home/developer/.pub-cache \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC

# ── PATH ─────────────────────────────────────────────────────
ENV PATH="${FLUTTER_ROOT}/bin:\
${PUB_CACHE}/bin:\
${ANDROID_SDK_ROOT}/platform-tools:\
${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:\
${GRADLE_HOME}/gradle-${GRADLE_VERSION}/bin:\
${PATH}"

# ── System packages ──────────────────────────────────────────
#
# Intentionally excluded:
#   openjdk-21-jdk    — not available in Debian 12 (Bookworm); installed
#                       separately via Eclipse Temurin / Adoptium APT.
#   libstdc++-12-dev  — clang on Bookworm uses its own bundled libc++;
#                       Flutter Linux builds work without it.
#   git-lfs           — project-level concern; add via postCreateCommand.
#   wget / vim        — curl covers all downloads; nano handles emergency edits.
#   iputils-ping      — network debugging belongs on the host.
#   libglu1-mesa      — not available on bookworm-slim; not required by
#                       Flutter's Linux desktop renderer.
#
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       curl git unzip zip xz-utils \
       bash nano jq htop tree procps \
       ca-certificates gnupg \
       openssh-client \
       clang cmake ninja-build pkg-config \
       libgtk-3-dev liblzma-dev \
       libgl1 \
       libfontconfig1 libfreetype6 \
       sudo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Java 21 (Eclipse Temurin via Adoptium) ───────────────────
#
# openjdk-21-jdk is NOT available in Debian 12 (Bookworm) APT repositories.
# Debian 12 ships OpenJDK 17 as its highest default version; OpenJDK 21 is
# only packaged for Debian 13 (Trixie) and above.
#
# Note: Temurin 25 is now the latest LTS line (as of late 2025), and is
# whichjdk.com's current recommendation for new projects. Staying on 21
# here is a deliberate choice pending a compatibility check against
# Gradle 9.7.x / AGP / Flutter before bumping — not an oversight.
#
# Eclipse Temurin is the Adoptium distribution of OpenJDK. It is:
#   - TCK-certified and AQAvit quality-verified (production-ready)
#   - Available for both linux/amd64 and linux/arm64 on Bookworm
#   - Maintained with quarterly security patches
#
# A canonical arch-agnostic symlink is created at /usr/local/temurin-21
# so JAVA_HOME is identical on both amd64 and arm64.
#
RUN curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
      | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] \
       https://packages.adoptium.net/artifactory/deb \
       $(. /etc/os-release && echo "${VERSION_CODENAME}") main" \
       > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends temurin-21-jdk \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(dirname "$(dirname "$(readlink -f "$(which java)")")")" /usr/local/temurin-21

ENV JAVA_HOME=/usr/local/temurin-21
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ── Browser: Chrome (amd64) / Chromium (arm64) ───────────────
RUN ARCH="$(dpkg --print-architecture)" \
    && if [ "$ARCH" = "amd64" ]; then \
         curl -fsSL https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
           -o /tmp/chrome.deb \
         && apt-get update \
         && apt-get install -y --no-install-recommends /tmp/chrome.deb \
         && rm /tmp/chrome.deb \
         && apt-get clean \
         && rm -rf /var/lib/apt/lists/* \
         && CHROME_BIN=/usr/bin/google-chrome-stable; \
       elif [ "$ARCH" = "arm64" ]; then \
         apt-get update \
         && apt-get install -y --no-install-recommends chromium chromium-driver \
         && apt-get clean \
         && rm -rf /var/lib/apt/lists/* \
         && CHROME_BIN=/usr/bin/chromium; \
       fi \
    && echo "export CHROME_EXECUTABLE=${CHROME_BIN}" \
         > /etc/profile.d/chrome.sh \
    && chmod 644 /etc/profile.d/chrome.sh

# ── GitHub CLI ───────────────────────────────────────────────
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
       https://cli.github.com/packages stable main" \
       | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Global npm tools ─────────────────────────────────────────
# firebase-tools is pinned via FIREBASE_TOOLS_VERSION and updated manually.
# Requires root — npm install -g writes to /usr/local/lib/node_modules.
# Latest release: https://www.npmjs.com/package/firebase-tools
RUN npm install -g \
    firebase-tools@${FIREBASE_TOOLS_VERSION}

# ── pnpm via Corepack ─────────────────────────────────────────
# Corepack ships bundled with Node but is dormant until explicitly enabled.
# Enabling it creates a symlink in /usr/local/bin, which requires root —
# hence this runs here, before the switch to the non-root `developer` user.
# Activating pnpm at build time means every generated project's
# `postCreateCommand: pnpm install` works immediately, with no per-project
# sudo workaround and no runtime download on first container start.
RUN corepack enable \
    && corepack prepare pnpm@${PNPM_VERSION} --activate

# ── Non-root developer user ──────────────────────────────────
RUN useradd -ms /bin/bash developer \
    && usermod -aG sudo developer \
    && echo "developer ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER developer
WORKDIR /home/developer

# ── Android SDK ──────────────────────────────────────────────
# cmdline-tools build 14742923 is the latest verified as of April 2026.
# NOT re-verified in this pass (2026-08-20) — check
# https://developer.android.com/studio#command-tools for a newer build
# number before bumping. A wrong number here 404s and fails the build.
RUN mkdir -p "${ANDROID_SDK_ROOT}/cmdline-tools" /home/developer/.android \
    && curl -fsSL \
       https://dl.google.com/android/repository/commandlinetools-linux-14742923_latest.zip \
       -o /tmp/cmdline-tools.zip \
    && unzip -q /tmp/cmdline-tools.zip -d "${ANDROID_SDK_ROOT}/cmdline-tools" \
    && mv "${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools" \
          "${ANDROID_SDK_ROOT}/cmdline-tools/latest" \
    && rm /tmp/cmdline-tools.zip \
    && touch /home/developer/.android/repositories.cfg \
    && yes | sdkmanager --licenses > /dev/null 2>&1 \
    && sdkmanager \
       "platform-tools" \
       "platforms;android-36" \
       "build-tools;36.0.0" \
       "cmdline-tools;latest"

# ── Gradle ───────────────────────────────────────────────────
# Pre-cached at /opt/gradle so the first `flutter build apk` skips the download.
RUN sudo mkdir -p "${GRADLE_HOME}" \
    && curl -fsSL \
       https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip \
       -o /tmp/gradle.zip \
    && sudo unzip -q /tmp/gradle.zip -d "${GRADLE_HOME}" \
    && rm /tmp/gradle.zip \
    && sudo chown -R developer:developer "${GRADLE_HOME}"

# ── Flutter SDK ──────────────────────────────────────────────
# Clones the stable channel (always the latest stable release).
# precache targets: android, web, linux only.
# iOS / macOS / Windows require platform toolchains unavailable on Linux.
RUN git clone --depth 1 -b stable \
      https://github.com/flutter/flutter.git "${FLUTTER_ROOT}" \
    && flutter config --no-analytics \
    && flutter precache --android --web --linux \
    && yes | flutter doctor --android-licenses > /dev/null 2>&1 \
    && flutter doctor

# ── FlutterFire CLI ──────────────────────────────────────────
# dart pub global writes to PUB_CACHE (/home/developer/.pub-cache).
# Must run as developer so the cache is owned by the correct user.
RUN dart pub global activate flutterfire_cli

# ── Shell customisation ───────────────────────────────────────
# Starship's install.sh writes to /usr/local/bin, so we switch to root.
# After install, fix ownership of all developer home config files.
USER root
COPY scripts/shell_setup.sh /tmp/shell_setup.sh
RUN bash /tmp/shell_setup.sh \
    && chown -R developer:developer /home/developer \
    && rm /tmp/shell_setup.sh
USER developer

# ── Default workspace ─────────────────────────────────────────
WORKDIR /workspace

# flutter run -d web-server binds to 0.0.0.0:8080 inside the container.
# devcontainer.json in flutter-template forwards this port to the host.
EXPOSE 8080

CMD ["sleep", "infinity"]
