# =============================================================
#  Flutter Dev Container
#
#  Base: node:24-trixie-slim (Node.js 24 LTS on Debian 13), pinned by
#  digest so every build starts from a known, reviewable base image.
#  Node is a first-class runtime dependency: Firebase CLI and
#  FlutterFire CLI both require it.
#
#  Pre-installed (environment only — no application code):
#    Flutter SDK      — stable channel, always latest
#    Dart SDK         — bundled with Flutter
#    Android SDK      — platform-tools, android-36, build-tools 36.0.0
#                       (Gradle comes from each project's own wrapper)
#    Java 21          — Eclipse Temurin (Adoptium), the same JDK on every
#                       Debian release and architecture
#    Node.js 24 LTS   — required by Firebase CLI
#    pnpm             — activated via Corepack at build time
#    Firebase CLI     — pinned, tracked by the dependency-drift workflow
#    FlutterFire CLI  — installed via dart pub global
#    Chromium         — Debian build on both architectures, with chromedriver
#                       (Flutter web, web tests and web integration tests)
#    lcov             — genhtml turns `flutter test --coverage` into HTML
#    Git + GitHub CLI — git-lfs excluded (project-level concern)
#    openssh-client
#    Starship prompt + Flutter/Dart/Git shell aliases
# =============================================================

ARG NODE_VERSION=24
# Multi-arch index digest of node:24-trixie-slim. The digest, not the tag,
# decides what is pulled; the weekly dependency-drift workflow reports when the
# tag has moved on so the digest can be refreshed deliberately.
ARG NODE_IMAGE_DIGEST=sha256:8ec5d7557396cfe32d21c3f9c13072355ceab22b584578ca4bb28af31120cffe

FROM node:${NODE_VERSION}-trixie-slim@${NODE_IMAGE_DIGEST}

# Re-declare after FROM so the ARG is available in this build stage.
ARG NODE_VERSION
# Build-time only (an ENV would leak into every `sudo apt` run in the container).
ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.title="Flutter Dev Container"
LABEL org.opencontainers.image.description="Full-stack Flutter development environment — Android · Web · Node 24 LTS · Firebase · FlutterFire"
LABEL org.opencontainers.image.authors="Ali Haidar"
LABEL org.opencontainers.image.source="https://github.com/alihaidar0/flutter-devcontainer"
LABEL org.opencontainers.image.documentation="https://github.com/alihaidar0/flutter-devcontainer#readme"
LABEL org.opencontainers.image.licenses="MIT"
# Dev Container image metadata: a devcontainer.json (or Compose service) that
# uses this image inherits the user, the Dart/Flutter extensions and the Flutter
# SDK path without repeating them (https://containers.dev/implementors/spec/#merge-logic).
LABEL devcontainer.metadata='[{"remoteUser":"developer","customizations":{"vscode":{"extensions":["Dart-Code.dart-code","Dart-Code.flutter"],"settings":{"dart.flutterSdkPath":"/home/developer/flutter"}}}}]'

# ── Pinned versions ───────────────────────────────────────────
# Last verified: 2026-10-04.
#   firebase-tools, pnpm, Starship, the cmdline-tools build and the node base
#   digest were confirmed against their official release channels on this date.
#   Android platform/build-tools levels match Flutter's default compileSdk (36).
#   The cmdline-tools build number is taken from
#   https://developer.android.com/studio#command-tools — a wrong build number
#   breaks the image build outright, so always copy its SHA-256 from that page.
#
# COREPACK_ENABLE_DOWNLOAD_PROMPT=0: Corepack must never wait for a "download
# this package manager?" answer in a non-interactive container step.
# CHROME_EXECUTABLE points at a stable symlink created in the browser layer and
# is set for every process, including IDE-launched ones that never read a shell
# profile.
# ANDROID_HOME is the variable Android's tooling documents today; its
# deprecated predecessor ANDROID_SDK_ROOT is kept, with the same value, so older
# tools still find the SDK.
ENV FIREBASE_TOOLS_VERSION=15.32.1 \
    PNPM_VERSION=12.9.1 \
    ANDROID_HOME=/home/developer/Android/sdk \
    ANDROID_SDK_ROOT=/home/developer/Android/sdk \
    FLUTTER_ROOT=/home/developer/flutter \
    GRADLE_USER_HOME=/home/developer/.gradle \
    PUB_CACHE=/home/developer/.pub-cache \
    CHROME_EXECUTABLE=/usr/local/bin/chrome-browser \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Etc/UTC

# ── PATH ─────────────────────────────────────────────────────
ENV PATH="${FLUTTER_ROOT}/bin:\
${PUB_CACHE}/bin:\
${ANDROID_SDK_ROOT}/platform-tools:\
${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:\
${PATH}"

# ── System packages ──────────────────────────────────────────
#
# Intentionally excluded:
#   openjdk-21-jdk    — Debian 13 does package it, but Eclipse Temurin (below)
#                       gives the identical JDK on every distro and architecture.
#   git-lfs           — project-level concern; add via postCreateCommand.
#   wget / vim        — curl covers all downloads; nano handles emergency edits.
#   iputils-ping      — network debugging belongs on the host.
#   clang / cmake / ninja / GTK dev libraries — the Linux desktop toolchain. A
#                       container cannot show a desktop window, and the project
#                       targets Android and web, so desktop support is switched
#                       off in the Flutter layer instead of being carried along.
#
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       curl git unzip zip xz-utils \
       bash bash-completion nano less jq htop tree procps \
       lcov \
       ca-certificates gnupg \
       openssh-client \
       sudo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Git: trust the workspace mount ───────────────────────────
# /workspace is a bind mount whose owner usually differs from the container
# user (always on Docker Desktop for Windows/macOS), and Git then refuses to
# work in it with "dubious ownership". System scope is baked in here so no
# consuming project needs a startup step for it, and so it still works when
# ~/.gitconfig is mounted read-only from the host.
RUN git config --system --add safe.directory /workspace

# ── Java 21 (Eclipse Temurin via Adoptium) ───────────────────
#
# Debian 13 packages OpenJDK 21 too, but Temurin is kept on purpose: it is the
# same TCK-certified build on every Debian release and on both architectures,
# so the JDK does not change when the base image does.
#
# Note: Temurin 25 is now the latest LTS line (as of late 2025), and is
# whichjdk.com's current recommendation for new projects. Staying on 21
# here is a deliberate choice pending a compatibility check against
# AGP / Flutter before bumping — not an oversight.
# (Flutter 3.47's Android template uses AGP 9.1, which needs JDK 17 or newer,
# so 21 is comfortably inside the supported range.)
#
# Eclipse Temurin is the Adoptium distribution of OpenJDK. It is:
#   - TCK-certified and AQAvit quality-verified (production-ready)
#   - Available for both linux/amd64 and linux/arm64 on Debian 13
#   - Maintained with quarterly security patches
#
# A canonical arch-agnostic symlink is created at /usr/local/temurin-21
# so JAVA_HOME is identical on both amd64 and arm64.
#
RUN curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
      | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] \
       https://packages.adoptium.net/artifactory/deb \
       $(. /etc/os-release && echo "${VERSION_CODENAME}") main" \
       > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends temurin-21-jdk \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(dirname "$(dirname "$(readlink -f "$(which java)")")")" /usr/local/temurin-21

ENV JAVA_HOME=/usr/local/temurin-21
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ── Browser: Chromium + chromedriver ─────────────────────────
# Debian's Chromium build is used on both architectures. It comes from the
# signed Debian repositories (Google only publishes Chrome for amd64, as an
# unsigned .deb download), receives security updates on every weekly rebuild,
# and ships a chromedriver of the same version, which Flutter's web integration
# tests (`flutter drive -d web-server`) need.
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium chromium-driver \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/chromium /usr/local/bin/chrome-browser

# ── GitHub CLI ───────────────────────────────────────────────
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
       https://cli.github.com/packages stable main" \
       | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Global npm tools ─────────────────────────────────────────
# firebase-tools is pinned via FIREBASE_TOOLS_VERSION and updated manually.
# Latest release: https://www.npmjs.com/package/firebase-tools
#
# It is installed into its own prefix instead of with `npm install -g` because
# `npm install -g` ignores `overrides`, and upstream's dependency tree contains
# advisories that have a patched release which firebase-tools has not picked up
# yet. docker/firebase-tools-overrides.json holds the overrides; CI audits the
# very same file (see the "npm audit" job), so what is audited is what ships.
# Requires root: the prefix is /opt/firebase-tools and the symlink goes to
# /usr/local/bin.
COPY docker/firebase-tools-overrides.json /tmp/firebase-tools-overrides.json
RUN mkdir -p /opt/firebase-tools \
    && jq --arg version "${FIREBASE_TOOLS_VERSION}" \
         '{name: "firebase-tools-image", private: true, dependencies: {"firebase-tools": $version}} + .' \
         /tmp/firebase-tools-overrides.json > /opt/firebase-tools/package.json \
    && npm install --prefix /opt/firebase-tools --omit=dev --no-audit --no-fund \
    && ln -s /opt/firebase-tools/node_modules/.bin/firebase /usr/local/bin/firebase \
    && rm /tmp/firebase-tools-overrides.json \
    && npm cache clean --force

# ── Corepack shims ───────────────────────────────────────────
# Corepack ships bundled with Node but is dormant until explicitly enabled.
# Enabling it creates symlinks in /usr/local/bin, which requires root —
# hence this runs here, before the switch to the non-root `developer` user.
# The pnpm download itself is done as `developer` further down.
RUN corepack enable

# ── Non-root developer user (UID/GID 1000) ───────────────────
# The node base image already owns UID/GID 1000 through its `node` user. Adding
# a second user would give `developer` UID 1001, which does not match the first
# user on a Linux host (UID 1000), so files in the bind-mounted /workspace would
# not be writable, and Dev Containers' automatic UID remapping skips the update
# when the target UID is already taken. Renaming `node` keeps UID/GID 1000 and
# leaves no unused account behind. `set -eux` makes the build fail loudly if a
# future base image no longer ships that user.
# Passwordless sudo goes in a drop-in file (mode 0440), not into /etc/sudoers.
RUN set -eux; \
    groupmod --new-name developer node; \
    usermod --login developer --home /home/developer --move-home node; \
    usermod -aG sudo developer; \
    echo "developer ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/developer; \
    chmod 0440 /etc/sudoers.d/developer; \
    test "$(id -u developer)" = 1000; \
    test "$(id -g developer)" = 1000

USER developer
WORKDIR /home/developer

# ── pnpm via Corepack ─────────────────────────────────────────
# `corepack prepare` stores the pnpm tarball in the cache of the user that runs
# it. Running it as root (as an earlier revision did) left the cache in
# /root/.cache, unreadable for `developer`, so the first `pnpm` call in a
# container downloaded pnpm again. Preparing it as `developer` puts the cache
# where the shim looks, so every project's `postCreateCommand: pnpm install`
# works offline, with no per-project workaround. CI verifies this with
# COREPACK_ENABLE_NETWORK=0.
RUN corepack prepare pnpm@${PNPM_VERSION} --activate

# ── Android SDK ──────────────────────────────────────────────
# cmdline-tools build 15859902 is the build linked from
# https://developer.android.com/studio#command-tools (verified 2026-10-03).
# Copy the new build number AND its SHA-256 from that page together: a wrong
# build number 404s the build, a wrong checksum fails it on purpose.
#
# The checksum-verified zip is only a bootstrap. It is unpacked outside the SDK
# and used to install the real `cmdline-tools;latest` package into
# ANDROID_SDK_ROOT with --sdk_root, then deleted. Unpacking it into the SDK and
# letting sdkmanager upgrade it in place (an earlier revision) left the
# superseded jars behind, including an older Bouncy Castle that vulnerability
# scanners kept reporting although nothing loaded it.
ARG CMDLINE_TOOLS_BUILD=15859902
ARG CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
RUN mkdir -p "${ANDROID_SDK_ROOT}" /home/developer/.android /tmp/cmdline-tools-bootstrap \
    && curl -fsSL \
       "https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS_BUILD}_latest.zip" \
       -o /tmp/cmdline-tools.zip \
    && echo "${CMDLINE_TOOLS_SHA256}  /tmp/cmdline-tools.zip" | sha256sum -c - \
    && unzip -q /tmp/cmdline-tools.zip -d /tmp/cmdline-tools-bootstrap \
    && rm /tmp/cmdline-tools.zip \
    && touch /home/developer/.android/repositories.cfg \
    && yes | /tmp/cmdline-tools-bootstrap/cmdline-tools/bin/sdkmanager \
         --sdk_root="${ANDROID_SDK_ROOT}" --licenses > /dev/null 2>&1 \
    && /tmp/cmdline-tools-bootstrap/cmdline-tools/bin/sdkmanager \
       --sdk_root="${ANDROID_SDK_ROOT}" \
       "platform-tools" \
       "platforms;android-36" \
       "build-tools;36.0.0" \
       "cmdline-tools;latest" \
    && rm -rf /tmp/cmdline-tools-bootstrap

# ── Gradle ───────────────────────────────────────────────────
# No standalone Gradle is installed: Flutter builds run the project's own
# Gradle wrapper (android/gradlew), whose version is chosen by Flutter's
# template and downloaded into GRADLE_USER_HOME on first use. GRADLE_USER_HOME
# is created here, owned by `developer`, so a named volume mounted over it is
# initialised with the right owner instead of root.
RUN mkdir -p "${GRADLE_USER_HOME}"

# ── Flutter SDK ──────────────────────────────────────────────
# Clones the stable channel (always the latest stable release).
# precache targets: android and web. iOS and macOS need Xcode and Windows needs
# its own toolchain, none of which exist on Linux, and a container cannot show a
# Linux desktop window, so the three desktop platforms are switched off. That
# keeps `flutter doctor` honest and makes `flutter create` generate only the
# android, ios and web folders; a project that wants one can re-enable it with
# `flutter config --enable-<platform>-desktop`.
RUN git clone --depth 1 -b stable \
      https://github.com/flutter/flutter.git "${FLUTTER_ROOT}" \
    && flutter config --no-analytics \
         --no-enable-linux-desktop --no-enable-macos-desktop --no-enable-windows-desktop \
    && flutter precache --android --web \
    && yes | flutter doctor --android-licenses > /dev/null 2>&1 \
    && flutter doctor

# ── FlutterFire CLI ──────────────────────────────────────────
# dart pub global writes to PUB_CACHE (/home/developer/.pub-cache).
# Must run as developer so the cache is owned by the correct user.
RUN dart pub global activate flutterfire_cli

# ── Shell customisation ───────────────────────────────────────
# Starship is installed to /usr/local/bin, so we switch to root. The release
# tarball is verified against the per-architecture SHA-256 below (published as
# `starship-<target>.tar.gz.sha256` on the GitHub release). These ARGs reach
# shell_setup.sh as environment variables.
# After install, fix ownership of all developer home config files.
USER root
ARG STARSHIP_VERSION=1.26.0
ARG STARSHIP_SHA256_AMD64=b7c232b0e8249d8e55a40beb79c5c43a7d370f3f9408bd215deb0170daeaadf3
ARG STARSHIP_SHA256_ARM64=dc30189378d2f2e287384e8a692d3f95ad1df64cf0e8c36aa9201516028aed6b
COPY scripts/shell_setup.sh /tmp/shell_setup.sh
RUN bash /tmp/shell_setup.sh \
    && chown -R developer:developer /home/developer \
    && rm /tmp/shell_setup.sh

# ── Login shells keep the toolchain on PATH ───────────────────
# Every tool above is on PATH through the ENV instructions. Debian's
# /etc/profile, however, resets PATH for login shells (`docker exec -l`,
# `su -l`, SSH sessions and the login-shell probe that Dev Containers uses), so
# flutter, java and the SDK tools would vanish there. A profile.d script written
# from the final image PATH restores them without repeating the list.
RUN printf 'export PATH="%s"\n' "${PATH}" > /etc/profile.d/10-dev-toolchain.sh \
    && chmod 0644 /etc/profile.d/10-dev-toolchain.sh
USER developer

# ── Default workspace ─────────────────────────────────────────
WORKDIR /workspace

# flutter run -d web-server binds to 0.0.0.0:8080 inside the container.
# devcontainer.json in flutter-template forwards this port to the host.
EXPOSE 8080

CMD ["sleep", "infinity"]
